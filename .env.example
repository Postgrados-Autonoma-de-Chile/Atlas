# ── ATLAS — variables de entorno (Fase 1) ─────────────────────────────────────
# Copia a .env y completa. En producción los secretos viven en Secret Manager (Fase 11),
# y la política es FAIL-CLOSED: con NODE_ENV=production los guards exigen sus secretos.

# Núcleo
PORT=3000
# URL pública del servicio (Cloud Run o túnel local), sin slash final.
BASE_URL=
# production | (vacío para desarrollo)
NODE_ENV=

# ── LLM (Anthropic) ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_CLASSIFIER=claude-haiku-4-5
# Esfuerzo de razonamiento por turno: low | medium | high (low = chat con baja latencia)
ANTHROPIC_EFFORT=low
# Timeout (ms) y reintentos del SDK
ANTHROPIC_TIMEOUT_MS=45000
ANTHROPIC_MAX_RETRIES=2

# ── STT para notas de voz (opcional; sin key, se pide el mensaje por texto) ──
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2

# ── Persistencia ──────────────────────────────────────────────────────────────
# Redis (Memorystore en GCP). En producción es OBLIGATORIO (memoria conversacional,
# locks, idempotencia, rate-limit). Sin él, fallback en memoria solo para desarrollo.
REDIS_URL=
# PostgreSQL (Cloud SQL en GCP). Auditoría hoy; fuente de verdad académica desde Fase 3.
DATABASE_URL=
# false | true (valida el certificado del servidor) | no-verify (solo legado explícito)
PGSSL=false
PGPOOL_MAX=10

# ── Webhook WhatsApp Cloud API (Meta) ────────────────────────────────────────
# Token que TÚ defines al suscribir el webhook (handshake GET hub.verify_token).
META_VERIFY_TOKEN=
# App Secret de la app de Meta: firma X-Hub-Signature-256 de cada POST.
META_APP_SECRET=

# ── Envío por WhatsApp (src/messaging — MessagingProvider) ───────────────────
# 'meta' = Cloud API directo · vacío = desactivado (los envíos se omiten con skipped:true)
WA_PROVIDER=
WA_CLOUD_PHONE_NUMBER_ID=
WA_CLOUD_TOKEN=
WA_GRAPH_VERSION=v23.0

# ── Seguridad / observabilidad ────────────────────────────────────────────────
# Cifrado AES-256-GCM de PII en reposo (64 hex chars). OBLIGATORIA en producción.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENC_KEY=
# Protege /metrics y /jobs/* (solo header x-dashboard-token; la query string no autentica).
DASHBOARD_TOKEN=
# Redacción de PII en logs: en producción es INCONDICIONAL; 'off' solo surte efecto en dev.
LOG_REDACT=on
# Retención de auditoría en días (purga diaria con lock). Default 90.
AUDIT_RETENTION_DAYS=90
# F12: guards y verificación de firma son FAIL-CLOSED por defecto. Para desarrollo local sin
# secretos, habilita explícitamente (PROHIBIDO en producción: el arranque aborta).
DEV_FAIL_OPEN=false

# ── Límites ───────────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=600
RATE_LIMIT_STRICT=240
MAX_CONCURRENT_TURNS=8

# ── Memoria conversacional (la académica vive en Postgres desde F3) ──────────
MEMORY_TTL_HOURS=48
MEMORY_MAX_TURNS=24

# ── Correo (F8: certificados y códigos de verificación) — SMTP genérico ──────
# Sirve para el SMTP institucional o el endpoint SMTP de un proveedor (Brevo/SendGrid/Resend).
# Sin SMTP_HOST/SMTP_FROM, los correos se omiten (dev) y la certificación queda en 'emitido'.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ATLAS UAutónoma <atlas@uautonoma.cl>"

# ── Recordatorios (F9) — job: POST /jobs/recordatorios (Cloud Scheduler en F11) ─
# Plantilla utility APROBADA por Meta para recordar fuera de la ventana de 24h.
# Sin ella, los recordatorios fuera de ventana se marcan 'omitido' (regla de Meta).
WA_TEMPLATE_RECORDATORIO=
WA_TEMPLATE_LANG=es
# Días de inactividad antes de recordar (también es la ventana del dedupe).
REMINDER_DIAS_INACTIVIDAD=3
# Tope de recordatorios sin nueva actividad (después se deja de insistir).
REMINDER_MAX_SIN_ACTIVIDAD=3

# ── RAG (F5): embeddings gemini-embedding-001 + pgvector ─────────────────────
# API key de Gemini (aistudio.google.com). Sin ella, buscar_contenido_curso degrada limpiamente.
# En F11 puede migrarse a Vertex AI (mismo modelo, auth ADC) cambiando solo src/ai/embeddings.ts.
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
# Similitud coseno mínima para dar un chunk por relevante (bajo esto: "no está en el material").
RAG_MIN_SCORE=0.55
RAG_TOP_K=6

# ── Pub/Sub (F11): split webhook/worker. Vacío = despacho in-process (dev / piloto 1 servicio) ─
# Ruta completa del topic (Terraform lo crea con ordering): projects/<proyecto>/topics/atlas-turnos
PUBSUB_TOPIC=
# Endpoint regional (ordering requiere publicar en la región del topic).
PUBSUB_ENDPOINT=https://pubsub.googleapis.com
# Service account del push OIDC (fail-closed sin ella) y audiencia opcional.
PUBSUB_PUSH_SA=
PUBSUB_PUSH_AUDIENCE=
