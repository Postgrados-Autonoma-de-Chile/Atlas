# ── ATLAS — variables de entorno (Fase 1) ─────────────────────────────────────
# Copia a .env y completa. En producción los secretos viven en Secret Manager (Fase 11),
# y la política es FAIL-CLOSED: con NODE_ENV=production los guards exigen sus secretos.

# Núcleo
PORT=3000
# URL pública del servicio (Cloud Run o túnel local), sin slash final.
BASE_URL=
# production | (vacío para desarrollo)
NODE_ENV=

# ── LLM (Anthropic) ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_CLASSIFIER=claude-haiku-4-5
# Esfuerzo de razonamiento por turno: low | medium | high (low = chat con baja latencia)
ANTHROPIC_EFFORT=low
# Timeout (ms) y reintentos del SDK
ANTHROPIC_TIMEOUT_MS=45000
ANTHROPIC_MAX_RETRIES=2

# ── STT para notas de voz (opcional; sin key, se pide el mensaje por texto) ──
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2

# ── Persistencia ──────────────────────────────────────────────────────────────
# Redis (Memorystore en GCP). En producción es OBLIGATORIO (memoria conversacional,
# locks, idempotencia, rate-limit). Sin él, fallback en memoria solo para desarrollo.
REDIS_URL=
# PostgreSQL (Cloud SQL en GCP). Auditoría hoy; fuente de verdad académica desde Fase 3.
DATABASE_URL=
PGSSL=false
PGPOOL_MAX=10

# ── Webhook WhatsApp Cloud API (Meta) ────────────────────────────────────────
# Token que TÚ defines al suscribir el webhook (handshake GET hub.verify_token).
META_VERIFY_TOKEN=
# App Secret de la app de Meta: firma X-Hub-Signature-256 de cada POST.
META_APP_SECRET=

# ── Envío por WhatsApp (src/messaging — MessagingProvider) ───────────────────
# 'meta' = Cloud API directo · vacío = desactivado (los envíos se omiten con skipped:true)
WA_PROVIDER=
WA_CLOUD_PHONE_NUMBER_ID=
WA_CLOUD_TOKEN=
WA_GRAPH_VERSION=v23.0

# ── Seguridad / observabilidad ────────────────────────────────────────────────
# Cifrado AES-256-GCM de secretos en reposo (64 hex chars). Obligatoria en producción (F12).
TOKEN_ENC_KEY=
# Protege /metrics (solo header x-dashboard-token; la query string ya no autentica).
DASHBOARD_TOKEN=
# Redacción de PII en logs (on por defecto; no apagar en producción).
LOG_REDACT=on
# Retención de auditoría en días (purga diaria con lock). Default 90.
AUDIT_RETENTION_DAYS=90

# ── Límites ───────────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=600
RATE_LIMIT_STRICT=240
MAX_CONCURRENT_TURNS=8
