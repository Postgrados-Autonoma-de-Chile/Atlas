{
  "name": "atlas",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "ATLAS — tutor educativo de IA por WhatsApp (Universidad Autónoma de Chile)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/index.cjs --external:pg-native --sourcemap",
    "start:prod": "node dist/index.cjs",
    "migrate": "node-pg-migrate -m migrations up",
    "migrate:down": "node-pg-migrate -m migrations down",
    "smoke:anthropic": "tsx scripts/smoke-anthropic.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-test-module-mocks --import tsx --test \"test/*.test.ts\"",
    "eval:tutor": "tsx scripts/evaluar-tutor.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "tsx": "^4.19.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "esbuild": "^0.28.2",
    "node-pg-migrate": "^9.0.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22"
  }
}
